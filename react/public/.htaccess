# Isthmus Meridian — Hostinger (LiteSpeed/Apache) config for the static export.
# Lives in react/public/ so `next build` copies it into out/, which is what gets
# uploaded to public_html.

# ---- Canonical host + HTTPS -------------------------------------------------
# One canonical origin: https://isthmusmeridian.com (bare, no www). Two URLs
# serving identical content splits search ranking and breaks OG cache keys.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # http -> https
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://isthmusmeridian.com/$1 [R=301,L]

  # www -> bare
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://isthmusmeridian.com/$1 [R=301,L]
</IfModule>

# ---- 404 --------------------------------------------------------------------
# Next's export emits 404.html; without this the host shows its own error page.
ErrorDocument 404 /404.html

# ---- Caching ----------------------------------------------------------------
# Everything under /_next/static/ is content-hashed, so it is safe to cache
# forever. HTML must never be cached hard or deploys won't be picked up.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|svg|png|jpg|jpeg|webp|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---- Compression ------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>
